{
  "buildCommand": "python3 build.py out && cp -r assets/historia out/assets/ && cd out && node ../fetch-images.mjs",
  "outputDirectory": "out",
  "installCommand": "echo skip",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/historia/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/assets/(site\\.css|site\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
